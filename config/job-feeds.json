{
  "feeds": [
    {
      "name": "Arbeitnow",
      "url": "https://www.arbeitnow.com/api/job-board-api",
      "format": "json",
      "region": "Europe/Global",
      "type": "general"
    }
  ],
  "public_api_sources": [
    {
      "name": "Jobicy",
      "url": "https://jobicy.com/api/v2/remote-jobs?count=200",
      "format": "json",
      "region": "Worldwide",
      "type": "remote",
      "requires_key": false,
      "attribution_required": true
    },
    {
      "name": "RemoteOK",
      "url": "https://remoteok.com/api",
      "format": "json",
      "region": "Worldwide",
      "type": "remote",
      "requires_key": false,
      "attribution_required": true
    }
  ],
  "credentialed_api_sources": [
    {
      "name": "Adzuna",
      "enabled": true,
      "requires": "ADZUNA_APP_ID and ADZUNA_APP_KEY",
      "countries": ["gb", "us", "ca", "au", "de", "fr", "nl", "nz", "sg", "za", "ng"]
    },
    {
      "name": "USAJOBS",
      "enabled": false,
      "requires": "USAJOBS_API_KEY",
      "region": "United States"
    }
  ],
  "verification_policy": {
    "never_claim_guaranteed_legitimacy": true,
    "preserve_original_application_url": true,
    "flag_unreachable_application_urls": true,
    "flag_scam_language": true,
    "deduplicate_by_canonical_url": true
  },
  "job_categories": [
    "Construction & Skilled Trades",
    "Technology & IT",
    "Engineering",
    "Healthcare",
    "Driving & Transport",
    "Logistics & Warehouse",
    "Hospitality & Catering",
    "Cleaning & Facilities",
    "Security",
    "Finance & Accounting",
    "Administration",
    "Sales & Customer Service",
    "Marketing & Design",
    "Education",
    "Retail",
    "Remote & Freelance",
    "Other"
  ]
}
